{
  // 用 jsonc 而不是 json，是为了能在规则旁边写清楚"为什么"——这份文件里几乎每条都对应
  //《正式版架构》里的一条纪律，光看规则名看不出来。
  //
  // 三件工具分工（见 6.2「静态检查」）：
  //   - Biome：格式化、通用 lint、单文件行数、循环依赖、包内禁止的 import；
  //   - dependency-cruiser（.dependency-cruiser.cjs）：包与包之间的单向依赖方向；
  //   - knip（knip.json）：未使用的导出和依赖。
  // 三个都由根目录的 `pnpm lint` 依次跑，任何一个红整条就红。
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    // 让 Biome 读 .gitignore，省得把构建产物、.env 这类东西再抄一遍。
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // 下面几条 .gitignore 里没有，得单独排除。
      "!**/node_modules",
      "!**/dist",
      "!**/.wrangler",
      // 旧客户端已冻结，不加功能也不整改，整包排除在 lint 之外（迁移第 7 条）。
      // 它的 typecheck 和测试照常在 CI 里跑——它还是线上跑着的那一版。
      "!packages/legacy-client",
      // wrangler types 生成的，改了也会被下次生成覆盖。
      "!packages/server/worker-configuration.d.ts",
      // 设计令牌的产物，由 packages/design/sd.config.mjs 从 tokens/*.json 生成（迁移第 8 条）。
      // 格式由生成器定，手改也会被下次 build 覆盖，所以格式化和 lint 都不看它；
      // 400 行那条上限同理——它管的是「人写的文件别长到没人读」，而令牌只会越加越多。
      "!packages/design/src/generated",
      // 回放测试的 golden，由 packages/core/test/golden/record.ts 生成（迁移第 15 条）。
      // 格式由生成器定（JSON.stringify 的两格缩进），手改或让 Biome 重排都会被下次重录覆盖；
      // 400 行那条上限同理——它管的是「人写的文件别长到没人读」，而 golden 是一局对局的流水。
      "!packages/core/test/golden/*.json",
      // 一次性脚本的输出，是数据不是代码。
      "!scripts/out",
      "!pnpm-lock.yaml",
      // Claude Code 自己会重写这个目录里的 json，格式化它只会让 CI 三天两头变红。
      "!.claude"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    // 100 是在现有代码上试出来的：80 到 120 之间逐个跑 `biome format`，
    // 100~102 处需要改动的行数最少，取整到 100。
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      // 对齐现有代码：不写分号、单引号、多行结构末尾带逗号。
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      // 以 recommended 那套为底，再按下面几条加加减减。
      "preset": "recommended",
      "style": {
        // 关掉。现有代码里有 171 处 `!`，全是被 tsconfig 的 noUncheckedIndexedAccess 逼出来的：
        // 开了那个选项之后 `arr[0]` 的类型是 `T | undefined`，而"这个下标一定有值"这件事
        // 往往是上一行刚校验过的，写 `arr[0]!` 就是把它说给类型检查器听。
        // 留着这条规则等于让每一次合法的下标访问都报一次警，几百条噪音会把真问题埋掉。
        "noNonNullAssertion": "off",
        // 7.2 第 3 条：单文件不超过 400 行，lint 卡死。
        // 含测试文件——测试一样会长到没人愿意读。
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 400 }
        },
        // 7.2 第 2 条：跨包只走包入口。具体两条禁令见下面每条 pattern 的 message。
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                // group 里是 gitignore 式的模式，支持 `!` 开头的否定项来开例外；
                // 和 .gitignore 一样后面的压前面的，所以放行那条必须排在两条禁令之后。
                "group": [
                  "@ai-duel/*/*",
                  "@ai-duel/*/**",
                  // 这是 design 包在 package.json 的 exports 里声明的第二个入口
                  // （"./tokens.css" -> src/generated/tokens.css），不是内部文件：
                  // React 那边要在应用入口 import 它，才能拿到 :root 上的那批 CSS 变量。
                  // 上面两条禁令按形状匹配，会把它一起拦掉，所以单独放行这一个精确路径——
                  // 只开这一条，别的深路径照旧禁。
                  "!@ai-duel/design/tokens.css"
                ],
                "message": "跨包只能 import 包名本身（比如 @ai-duel/core），不能伸进它的内部文件。每个包对外只有 src/index.ts 一个入口，内部文件怎么摆是它自己的事。见《正式版架构》7.2 第 2 条。"
              },
              {
                "group": [
                  "../*/src/**",
                  "../../*/src/**",
                  "../../../*/src/**",
                  "../../../../*/src/**",
                  "../../../../../*/src/**",
                  // 上面几条里的 `*` 按 gitignore 的规矩能匹配到 `..`，于是包**内部**从
                  // 二级目录回到自己的 src（比如 dev/storybook 引 src/dev 里的图集加载）
                  // 也会被误判成"穿到别的包里"。`../../src/` 前面只有两级，
                  // 落点必然还在同一个包里，单独放行。别扩大到 `../src/`——
                  // 那一级正好是 packages/ 下的兄弟包。
                  "!../../src/**"
                ],
                "message": "别用相对路径穿到另一个包里。要用别的包就在 package.json 里声明依赖，然后 import 包名（比如 @ai-duel/core）——绕过包名等于绕过依赖方向检查。见《正式版架构》7.2 第 1、2 条。"
              }
            ]
          }
        }
      },
      "suspicious": {
        // 6.2：循环依赖。dependency-cruiser 那边也有一条同样的规则，
        // 但它只看 packages/ 和 apps/ 的模块图，Biome 这条是文件级的兜底。
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      // knip 用 JSONC 解析自己的配置，所以 knip.json 里是有注释的。
      // Biome 按扩展名判断，不开这个开关会把每条注释报成语法错误。
      "includes": ["knip.json"],
      "json": { "parser": { "allowComments": true } }
    },
    {
      // 6.2：core、content、protocol、design 不碰浏览器对象。
      //
      // 这四个包要能原样跑在浏览器、Cloudflare Worker 和 Node 三种环境里，
      // 碰了 window / document 就只剩浏览器一种，服务端权威那条（需求第 6 条）第一个做不成。
      // Node 内建模块那半边由 .dependency-cruiser.cjs 的「边界-底层包不碰-node-内建」管：
      // 那些是 import，这些是全局变量，两种东西得分开查。
      "includes": ["packages/{core,content,protocol,design}/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "这个包要能在浏览器、Worker、Node 三种环境里原样跑，不能碰浏览器对象。需要平台能力就走 platform 包的接口。",
                  "document": "这个包要能在浏览器、Worker、Node 三种环境里原样跑，不能碰 DOM。需要平台能力就走 platform 包的接口。",
                  "localStorage": "存储走 platform 包的接口，别直接碰浏览器的实现。",
                  "navigator": "这个包要能在浏览器、Worker、Node 三种环境里原样跑，平台信息走 platform 包的接口。"
                }
              }
            }
          }
        }
      }
    },
    {
      /*
       * 6.5 / 迁移第 16 条：演出编排层是纯 TS 的时间驱动状态机，不许碰 Pixi 和 GSAP。
       *
       * 碰了就等于把「什么时候演」和「怎么演」重新粘回一起——旧版 MatchStage 正是这么长到
       * 3950 行、一条测试都写不了的。而且 GSAP 的时间线自带真实时钟，假时钟测试立刻失效。
       *
       * 这条为什么在 Biome 不在 dependency-cruiser：分工是「包与包之间的方向在那边，
       * 包内禁止的 import 在这边」。dependency-cruiser 现在也看得见第三方的边了
       * （node_modules 从 exclude 挪成了 doNotFollow），所以那边**能**写这条，
       * 只是没必要写两遍，就留在这里。
       * 编排层不许依赖别的**包**（platform 等）那半条仍在 dependency-cruiser，
       * 分工见那份配置里「边界-director-只许依赖-core-和-design」的注释。
       *
       * 下面前两条 group 是上面根配置那两条禁令的**副本**：Biome 的 override 对同一条规则是
       * 替换选项而不是合并，不抄过来的话这个目录就漏掉了「跨包只走包入口」那两条。
       * 改根配置那两条时这里要跟着改。
       */
      "includes": ["packages/canvas/src/director/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ai-duel/*/*", "@ai-duel/*/**", "!@ai-duel/design/tokens.css"],
                    "message": "跨包只能 import 包名本身（比如 @ai-duel/core），不能伸进它的内部文件。每个包对外只有 src/index.ts 一个入口，内部文件怎么摆是它自己的事。见《正式版架构》7.2 第 2 条。"
                  },
                  {
                    "group": [
                      "../*/src/**",
                      "../../*/src/**",
                      "../../../*/src/**",
                      "../../../../*/src/**",
                      "../../../../../*/src/**",
                      "!../../src/**"
                    ],
                    "message": "别用相对路径穿到另一个包里。要用别的包就在 package.json 里声明依赖，然后 import 包名（比如 @ai-duel/core）——绕过包名等于绕过依赖方向检查。见《正式版架构》7.2 第 1、2 条。"
                  },
                  {
                    "group": ["pixi.js", "pixi.js/**", "gsap", "gsap/**"],
                    "message": "演出编排层是纯 TS 的：它只产出「什么时候演什么、演多久」，怎么画交给渲染器，后续按虚拟时钟自己排期，不用补间库。碰了这两个就测不动了。见《正式版架构》6.5。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // 白名单豁免：core 这三个文件现在就超 400 行。
      //
      // 到期条款：第三阶段（迁移第 12-15 条）重做 core 时把它们拆掉，
      // 顺手删掉这段 override。在那之前它们不许再长——新代码请开新文件。
      //   engine.ts       规则引擎主体。第 12 条把卡牌、题库、答题剧本搬去 content 之后它并没有变短：
      //                   引擎本来就不存数据，只是把 import 数据换成了查状态里的目录（GameState.catalog）。
      //                   真要瘦下来得把技能牌结算和答题结算拆成单独文件。
      //   types.ts        类型定义。卡牌、英雄、题目的类型**留在这里不搬**：content 依赖 core 拿类型，
      //                   反过来就把依赖方向拧了（第 12 条定的）。第 14 条会把协议相关的搬去 protocol。
      //   engine.test.ts  跟着 engine.ts 一起拆
      "includes": [
        "packages/core/src/engine.ts",
        "packages/core/src/types.ts",
        "packages/core/test/engine.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ]
}
