{
  // 未使用的导出和未使用的依赖，对应《正式版架构》6.2 最后一条。
  // 格式化和通用 lint 在 biome.jsonc，包之间的依赖方向在 .dependency-cruiser.cjs。
  //
  // 文件叫 .json 但写着注释：knip 用 JSONC 解析自己的配置。
  // Biome 认的是扩展名，所以 biome.jsonc 里给这个文件单独开了 allowComments。
  "$schema": "./node_modules/knip/schema.json",

  "workspaces": {
    // 仓库根目录本身不是一个包，只有 scripts/ 下几个一次性脚本。
    // 它们是各自独立的入口（命令行直接 node 跑），不写进来会被当成没人要的死文件。
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },

    /*
     * 下面这些 ignoreDependencies 全是同一件事：包还是空的（src/index.ts 只有一句 export {}），
     * 但 package.json 里已经按《正式版架构》7.2 第 1 条把允许的依赖方向声明好了。
     * 这是骨架阶段的预期状态，不是"忘了删的依赖"。
     *
     * 到期条款：哪个包开始写代码、真的 import 了这些东西，就把它自己这条删掉。
     * 全部删完这一整段也就没了。别反过来——发现 knip 报某个依赖没用就往这儿加，
     * 那才是把这条检查废掉。
     */
    "packages/canvas": {
      // 组件目录页的条目也是入口：story 文件没人 import，Storybook 是按文件名扫进来的
      // （见 packages/client/dev/storybook/main.ts 的 stories）。
      // 包入口 src/index.ts 不用写，knip 从 package.json 的 exports 里认。
      "entry": ["src/**/*.stories.ts"]
      // 这里原来有一条 ignoreDependencies: ["@ai-duel/platform"]，按上面的到期条款删掉了：
      // 迁移第 17 条的匾额按钮按下时要调触感和音效（见 components/PlaqueButton.ts）。
    },
    "packages/ui": {
      // 同 canvas：目录页条目也是入口。
      "entry": ["src/**/*.stories.tsx"],
      /*
       * react-dom 和 @types/react-dom 两条按上面的到期条款删掉了：组件测试要靠它渲染。
       * design 不在这儿也不在 package.json 里了——正式版简化第 3 步把这个包的样式
       * 全部剥成素方块，一条 `var(--…)` 都不剩，依赖跟着去掉（重做视觉时再加回来）。
       * 剩 platform 一个还没有调用方——这个包里还没有要碰音频 / 存储 / 全屏的组件。
       */
      "ignoreDependencies": ["@ai-duel/platform"]
    },
    "packages/bench": {
      /*
       * design 和 canvas 两条都按上面的到期条款删掉了：桩场景在读 @ai-duel/design 的令牌，
       * 剧本驱动的是 @ai-duel/canvas 的对局场景（迁移第 3 条接上的）。
       * platform 还留着——接口还没定（迁移第 11 条）。
       */
      "ignoreDependencies": ["@ai-duel/platform"],
      /*
       * uv 是本机的 Python 运行器，不是 npm 包，装不进 package.json。
       * 时间指标那一步用它跑 scripts/frames.py（见 6.12「解析 trace 取帧时间」那行），
       * 没装的话 tests/timing.spec.ts 会整组跳过而不是失败。
       */
      "ignoreBinaries": ["uv"]
    },
    "packages/client": {
      /*
       * 组件目录页那一摊（迁移第 10 条）和端到端那一条（第 21 条）。
       * 这几个文件谁也不 import 谁：main.ts / preview.tsx 由 Storybook 按约定加载，
       * catalog.spec.ts / ensureAtlas.ts / localMatch.spec.ts 由 Playwright 加载，
       * 全是各自独立的入口。e2e/ensureServer.mjs 更彻底：它是服务端那条 webServer
       * 命令行里 `node` 直接跑的，连 Playwright 都不认识它（理由见那个文件的头）。
       * 包入口 src/index.ts 和两份 playwright.config.ts 不用写：前者 knip 从
       * package.json 的 exports 里认，后者由它的 Playwright 插件认。
       *
       * 这个包原来还有一段 ignoreDependencies（canvas、content、core、design、platform、
       * protocol、react、ui 八条），按上面的到期条款全删光了——装配层把它们全用上了。
       */
      "entry": [
        "dev/storybook/main.ts",
        "dev/storybook/preview.tsx",
        "dev/storybook/catalog.spec.ts",
        "dev/storybook/ensureAtlas.ts",
        "e2e/globalSetup.ts",
        "e2e/ensureServer.mjs",
        "e2e/localMatch.spec.ts",
        "e2e/online.spec.ts"
      ]
    },
    "apps/mobile": {
      /*
       * 两个原生插件（迁移第 36 条）。**import 它们的是 `packages/platform`**，这个包一行都没碰，
       * 所以 knip 看着像"装了没用"。
       *
       * 不能只装在 platform 里：Capacitor 的命令行是照**壳自己的 package.json**
       * 找插件的，只装在依赖里的话 `cap sync` 会报「Found 0 Capacitor plugins」，
       * 原生工程里压根不会有这两个插件的代码——实测过，不是猜的。
       * 这不是到期条款，是 Capacitor 的工作方式，插件增减时这份名单要跟着改。
       *
       * `@capacitor/android`、`@capacitor/ios`、`@capacitor/core`、`@capacitor/cli`
       * 不在这儿：knip 自带的 Capacitor 插件认得它们（它会读 capacitor.config.ts）。
       */
      "ignoreDependencies": ["@capacitor/app", "@capacitor/haptics"]
    },
    "apps/steam": {
      /*
       * 两个谁也不 import 的入口。
       * preload.ts 是 Electron 按**路径字符串**加载的（见 src/window.ts 的 webPreferences），
       * 源码里没有任何一行 import 它；smoke.spec.ts 由 Playwright 加载，而它那份配置在
       * e2e/ 下面、不是默认位置，knip 的 Playwright 插件扫不到（同 packages/client）。
       */
      "entry": ["src/preload.ts", "e2e/smoke.spec.ts"]
    },
    "packages/server": {
      "ignoreDependencies": [
        // cloudflare:workers 是 Workers 运行时的内建模块，不是 npm 包。
        // knip 按冒号前面那段当包名找，所以看着像"用了没装"。
        //
        // content、core、protocol 三条按上面的到期条款删掉了：
        // 房间对象（迁移第 22 条）在跑 core 的 execute、发 protocol 的消息、
        // 用 content 的卡表和题库。
        "cloudflare"
      ]
    }
  }
}
