{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // vite.config.ts 跑在 Node 里，和浏览器代码共用一份配置，所以两边的全局类型都要带上；
    // vite/client 提供 import './xx.css' 这类资源导入的类型声明。
    "types": ["node", "vite/client"],
    // 这一版已经冻结，规则和数据都用自己那份快照（src/core-snapshot，见 README），
    // 不跟着新 core 的破坏性改动走。源码里的 import 一行都不用改，靠这条别名接过去。
    // vite.config.ts 里有一条一模一样的 resolve.alias（vitest 也读那份配置），改一处要改两处。
    "paths": {
      "@ai-duel/core": ["./src/core-snapshot/index.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
