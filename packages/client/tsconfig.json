{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // 装配层最终跑在浏览器 / WebView / Electron 渲染进程里，所以要 DOM 全局类型，
    // 屏幕组件是 JSX。不加 "node"：误用 process、fs 这类 Node 全局要在编译期就拦下来。
    "types": []
  },
  "include": ["src"]
}
