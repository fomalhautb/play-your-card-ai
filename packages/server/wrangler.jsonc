{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-duel",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",

  // better-auth 要 `node:async_hooks`（它用 AsyncLocalStorage 传请求上下文），
  // 没有这个标志部署上去一调 /api/auth/* 就报模块找不到。
  // 只是多给运行时补上 Node 的那几个内置模块，房间对象的行为不受影响。
  "compatibility_flags": ["nodejs_compat"],

  // 账户 ID 是标识符不是凭据——没有 API token 它什么也做不了，Cloudflare 官方示例
  // 也是直接写在配置里的。写死在这里，CI 就只需要 CLOUDFLARE_API_TOKEN 一个 secret。
  "account_id": "bc5fd400f5d0e8eb68fd03f019727972",

  // 前端构建产物和 Worker 脚本部署成同一个 Worker、同一个域名，
  // 所以客户端连 WebSocket 时用相对路径就行，不需要配跨域，也不需要第二个服务。
  "assets": {
    // 网页壳的构建产物（`pnpm --filter @ai-duel/web build`）。这个目录是 gitignore 掉的，
    // 仓库里没有，所以部署前必须先构建（deploy.yml 里那一步）。
    "directory": "../../apps/web/dist",
    // 前端是单页应用：/room、/deck 这种路径在磁盘上没有对应文件，回落到 index.html 交给前端路由。
    "not_found_handling": "single-page-application",
    // 给 Worker 一个手动取静态资源的入口。Worker 兜底处理没匹配上的请求时靠它回 index.html。
    "binding": "ASSETS",
    // 默认情况下静态资源层先响应、匹配不到才轮到 Worker；但 not_found_handling 是 SPA 时
    // 「匹配不到」也会被资源层吃掉回 index.html，Worker 永远轮不上。
    // 所以要 Worker 处理的路径必须在这里显式列出来，否则 WebSocket 升级请求
    // 只会拿到一份 index.html（这是实测出来的，不是猜的）。
    //
    // /match/* 是房间对象的 WebSocket 端点（src/room/MatchRoom.ts），
    // /lobby 是大厅对象的（src/lobby/Lobby.ts）。
    // 前端的对局页路由是 `/match`（不带房间码），落不进 `/match/*`，仍然由资源层回 index.html，
    // 所以这条不会把页面请求也拽进 Worker。
    // 账号系统的 /api/auth/* 已经被 "/api/*" 这条盖住了，不用单列。
    "run_worker_first": ["/api/*", "/match/*", "/lobby"]
  },

  // 正式域名。两条都是 Workers Custom Domain：域名的 zone 就在上面那个账号下，
  // Cloudflare 会自动建好 DNS 记录、签好证书，仓库里不需要维护任何解析配置。
  //
  // 注意 CI 的 token 是按 "Edit Cloudflare Workers" 模板建的，不一定带 Zone/DNS 权限。
  // 万一将来部署卡在挂 custom domain 这一步报权限错误，要么给 token 补上 Zone/DNS 权限，
  // 要么直接删掉这两行——域名已经在 Cloudflare 服务端挂好了，删掉不会解绑。
  "routes": [
    { "pattern": "playyourcardai.online", "custom_domain": true },
    { "pattern": "www.playyourcardai.online", "custom_domain": true }
  ],

  // MATCH_ROOM 是权威房间（src/room/MatchRoom.ts），LOBBY 是做匹配的大厅
  // （src/lobby/Lobby.ts，全局单实例）。绑定名和类名都不能改——
  // Durable Object 是按类名找实例的，改名等于把正在打的房间全丢了。
  "durable_objects": {
    "bindings": [
      { "name": "MATCH_ROOM", "class_name": "MatchRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },

  // 账号库（better-auth，见 src/auth/）。用 D1 而不是再开一个 Durable Object：
  // 账号数据是全局要查的关系型数据（按 id 找人、将来按邮箱找人），
  // 而 DO 的 SQLite 是一个实例一份，天然做不了跨实例查询。
  //
  // database_id 是**用户自己建库之后才有的**，仓库里放不了真值：
  //   wrangler d1 create ai-duel-auth      # 输出里的 database_id 填到下面
  //   wrangler d1 migrations apply AUTH_DB --remote
  // 详见 docs/deploy.md「账号库」一节。测试和 `wrangler dev` 不看这个 id，
  // miniflare 按绑定名在本地现建一个库。
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "ai-duel-auth",
      "database_id": "<待用户 wrangler d1 create 后填写>",
      "migrations_dir": "migrations"
    }
  ],

  // Durable Object 的生命周期。新写法，取代了旧的 migrations 数组，两者只能二选一
  // （同时写 wrangler 会直接报 "mutually exclusive" 拒绝部署）。
  // 免费档只支持 SQLite 后端的 Durable Object，storage 必须是 "sqlite"。
  //
  // `Room` 是黑客松那版纯转发器的房间，代码已经删了（迁移第 38 条），
  // 但线上那个命名空间还在 Cloudflare 那边挂着。`state: "deleted"` 是它的墓碑：
  // 光从这份配置里删掉一行，wrangler 只会报「绑定没了但命名空间还在」，
  // 写成墓碑才是告诉 Cloudflare「这个类没了，把命名空间连同数据一起退役」。
  // **合并后第一次部署就会执行，旧房间里的数据全部删除、不可恢复**（见 docs/deploy.md）。
  // 墓碑要一直留着，别在下一个 PR 里"顺手清理掉"——删掉等于告诉 Cloudflare 这个类又回来了。
  "exports": {
    "Room": { "type": "durable-object", "state": "deleted" },
    "MatchRoom": { "type": "durable-object", "storage": "sqlite" },
    "Lobby": { "type": "durable-object", "storage": "sqlite" }
  }
}
