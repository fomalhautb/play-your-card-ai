# 本地开发用的密钥。复制成同目录的 .dev.vars（那个文件不进仓库）再换成自己的随机串：
#
#   cp packages/server/.dev.vars.example packages/server/.dev.vars
#   openssl rand -base64 32     # 拿它的输出替换下面那一行
#
# 线上不走这个文件，走 `wrangler secret put BETTER_AUTH_SECRET`。
#
# 这一条是 better-auth 的主密钥：签会话 cookie，以及加密存在 D1 里的 JWT 私钥。
# 换掉它，本地那个 D1 库里已经生成的私钥就解不开了，得把 jwks 表清掉重来
# （本地库在 packages/server/.wrangler/ 下面，直接删掉整个目录也行）。
BETTER_AUTH_SECRET=本地开发用的随便一串够长的密钥

# 有这一行就是「本地开发」。`wrangler deploy` 不带 .dev.vars 上去，所以线上必然没有它，
# 服务端拿它区分环境（`room:error malformed` 回不回给客户端，以及下面 Steam 那两行没配时
# 要不要收假票据，见 src/devMode.ts）。
DEV=1

# Steam 登录（迁移第 35 条，见 src/auth/steamTicket.ts）。两行都**注释掉就是不配**，
# 那时本地开发走「任何票据都收」，steamId 由票据算出来——本机没有 Steam 客户端也测得了。
#
# 配上真密钥就会真的去问 Valve，本地也一样。想在本机验真流程时才打开这两行：
# STEAM_WEB_API_KEY 从 Steamworks 后台的「发行商 Web API 密钥」拿（线上走 wrangler secret put），
# STEAM_APP_ID 填这个游戏自己的 appId（不填是 480，Valve 的 SpaceWar 试验田）。
# STEAM_WEB_API_KEY=从 Steamworks 后台拿的发行商密钥
# STEAM_APP_ID=480
