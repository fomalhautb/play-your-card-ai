{
  "name": "@ai-duel/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:local && wrangler dev",
    "db:local": "wrangler d1 migrations apply AUTH_DB --local",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime=false",
    "smoke": "node test/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-duel/content": "workspace:*",
    "@ai-duel/core": "workspace:*",
    "@ai-duel/protocol": "workspace:*",
    "better-auth": "^1.7.3",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
