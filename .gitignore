node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# `pnpm assets:build` 的产物，源头全在 assets/source/（见 assets/README.md）。
# 图集有几兆，进仓库只会把每次改原画都变成一次大 diff；界面底图和音频是源文件的副本，
# 同一份东西进两次 git 更没道理。apps/web/public 下除了 .gitkeep 就只有这些产物。
# assets/dist/ 已经被上面的 dist/ 覆盖，这几条是脚本分发过去的副本。
apps/web/public/atlas/
apps/web/public/audio/
apps/web/public/battle/
apps/web/public/hero/
apps/web/public/home/
apps/web/public/info/
apps/web/public/room/
packages/bench/public/atlas/

# AssetPack 的增量缓存目录，在哪儿跑就落在哪儿。
.assetpack/

# wrangler dev 的本地状态：构建缓存，以及 miniflare 给 Durable Object 建的 SQLite 库。
# 纯本地产物，每台机器都不一样，删掉下次 `wrangler dev` 会重新生成。
.wrangler/

.DS_Store
.idea/
.vscode/

*.log
npm-debug.log*
pnpm-debug.log*

.env
.env.local
.env.*.local

# wrangler 的本地密钥（packages/server 的 BETTER_AUTH_SECRET）。样例在同目录的 .dev.vars.example。
.dev.vars

.pnpm-store/
tmp/
output/
scripts/out/pregen-smoke.json

# 组件目录页的产物（迁移第 10 条）。
# storybook-static 是 `build-storybook` 打出来的静态站；
# 截图回归失败时 Playwright 会把差异图和 trace 留在 test-results/ 里。
# 基线图（dev/storybook/baselines/）反过来**要**进仓库，那是比对的依据。
packages/client/storybook-static/
packages/client/test-results/
packages/client/playwright-report/

# 性能剧本的产物（迁移第 2 条）。
# results/ 是每台机器各跑各的数字，提交进来只会天天冲突；
# public/atlas/ 是图集脚本从别处复制过来的，源头在美术资源那边不在这里；
# test-results/ 和 playwright-report/ 是 Playwright 失败时留的现场。
packages/bench/results/
packages/bench/test-results/
packages/bench/playwright-report/

# Steam 壳的产物（迁移第 35 条）。
# release/ 是 electron-builder 打出来的 .app / AppImage，几百兆；
# 主进程和渲染进程的产物在 apps/steam/dist/ 下，已经被上面那条 dist/ 盖住了。
# test-results/ 和 playwright-report/ 是冒烟用例失败时留的现场。
apps/steam/release/
apps/steam/test-results/
apps/steam/playwright-report/
