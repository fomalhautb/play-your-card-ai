{
  // 冒烟用例跑在 Node 里（Playwright 自己把 Electron 拉起来），所以这份和主进程那份一样
  // 不带 DOM 的全局类型——`page.evaluate` 里的 DOM 类型由 Playwright 的声明带进来。
  // 单独一份是因为 tsconfig.json 那份要产出 JS（Electron 要 CommonJS 文件），
  // 而用例只需要类型检查。
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["."]
}
